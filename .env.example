# SUPABASE — PUBLIC (included in browser builds)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Supabase is the only supported authentication provider.
VITE_AUTH_PROVIDER=supabase

# SUPABASE — SERVER (same URL and publishable key as above)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Modern sb_secret_ key or legacy service_role JWT; never expose via VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# OPENROUTER — SERVER ONLY
# Create at openrouter.ai; keys from other services are not interchangeable.
# Endpoint is fixed in code: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# One model for all roles; verify structured_outputs support before live use.
OPENROUTER_MODEL_DEFAULT=openai/gpt-4.1-mini
# Optional kill switch; defaults to enabled.
OPENROUTER_ENABLED=true

# APPLICATION
# Mock is deterministic and makes no external AI calls. Set live deliberately.
AI_PROVIDER_MODE=mock
APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173

# OPTIONAL CONTROLS (defaults shown; omit unless changing them)
# AI_PROVIDER_TIMEOUT_MS=90000
# AI_PROVIDER_MAX_RETRIES=0
# AI_MAX_OUTPUT_TOKENS=12000
# AI_DAILY_REQUEST_LIMIT=10
# AI_GENERATION_ENABLED=true
# AI_LIMIT_CLASSIFY_AND_CLARIFY_PER_DAY=10
# AI_LIMIT_GENERATE_PLAN_GRAPH_PER_DAY=10
# AI_LIMIT_REPLAN_PER_DAY=10
# SUPABASE_STORAGE_BUCKET=reversepath-files

# OPTIONAL TEST GATES — primary Supabase credentials and disposable accounts
# RUN_SUPABASE_RLS_TESTS=false
# RUN_E2E_GOLDEN=false
# RUN_E2E_SCENARIOS=false
# RUN_E2E_SIGNUP=false
# E2E_SIGNUP_EMAIL_TEMPLATE=your-authorized-mailbox+{runId}@your-domain
# RUN_LIVE_AI_SMOKE=false
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_PORT=4173
